/dts-v1/;

#include "RTL8197F.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "greatek,gwr1200ac", "realtek,rtl8197f-soc";
	model = "Greatek GWR1200AC V1";

	memory {
		device_type = "memory";
		reg = <0x0 0x4000000>;
	};

	/* R6: persistent crash log. Backed by pstore/ramoops so an oops/panic
	 * survives the reboot that panic_on_oops+panic=3 already trigger, and
	 * is readable afterwards from /sys/fs/pstore/. The last 128K of the
	 * 64MB DRAM are carved out here; the kernel excludes this range from
	 * the normal allocator, it is not "lost" RAM in any other sense.
	 * console-size >> record-size deliberately: pstore's own oops/panic
	 * dump path takes a semaphore that is not safe to block on from
	 * interrupt context (see the pstore_cannot_wait() fix in this repo's
	 * kernel patches) — the console mirror, written through printk's
	 * always-irq-safe console callback, is what actually survives a crash
	 * that lands mid-interrupt, so it gets the larger share. */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ramoops@3fe0000 {
			compatible = "ramoops";
			reg = <0x3fe0000 0x20000>;
			record-size = <0x8000>;
			console-size = <0x18000>;
		};
	};

	chosen {
		/* R3: hwnat is deliberately NOT enabled here. Measured on hardware: setting
		 * rtl819x.hwnat=1 on the cmdline turns hardware NAT on before the ASIC's L2/L3
		 * tables are warm, and the datapath then fails completely — host<->box was 100%
		 * loss and returned to 0% the instant `echo 0 > .../parameters/hwnat` + a
		 * fabric_reset ran. Same interaction seen earlier when hwnat=1 killed even ICMP
		 * forwarding on a cold ASIC. Offload must be armed AFTER bring-up (gw_prog + L2
		 * warm), so it belongs in the boot script, not the kernel command line — and it
		 * stays off until the WAN->LAN reverse path is fixed, because a sustained
		 * download with offload on wedges the box.
		 * R5: ipv6.disable=1 removed — odhcpd/odhcp6c/ip6tables were already in the
		 * image but inert while v6 was disabled at the kernel. */
		bootargs = "console=ttyS0,38400";
	};

	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		#address-cells = <1>;
		#size-cells = <0>;
		poll-interval = <20>;

		/* R3: all decoded from the stock gpiom.ko `dev_buttons` table
		 * (rootfs lib/modules/gpiom.ko file offset 0x31a0, stride 13:
		 * char name[10]; u8 pin; u8 active_low; u8 bank) and cross-checked
		 * against dev_button_init_hook, which registers them with the vendor
		 * kernel as bank*32+pin = 54/56/36. */
		reset {
			label = "reset";
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;	/* vendor 54 */
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio1 24 GPIO_ACTIVE_LOW>;	/* vendor 56 */
			linux,code = <KEY_WPS_BUTTON>;
		};

		/* Stock declares a third button "wifi" at bank1 pin4 (vendor 36).
		 * Left out deliberately: if this unit has no such button the pin may
		 * float and emit spurious KEY_RFKILL, which would toggle the radio at
		 * random. Enable only after confirming the button physically exists.
		 *	rfkill {
		 *		label = "wifi";
		 *		gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
		 *		linux,code = <KEY_RFKILL>;
		 *	};
		 */
	};

	/*
	 * R3: LEDs. This node used to be commented out as "Breaks device switch".
	 * ★ ROOT CAUSE FOUND — it was on the WRONG PIN. It used <&gpio1 25>, which is
	 * not the WPS LED and has no use anywhere in the stock firmware; it sits ONE
	 * PIN away from <&gpio1 26>, the RTL8367S hardware reset (vendor gpio 58,
	 * global 474, pulsed low/high by the vendor's rtl865x_initAsicL2 @0x80198294).
	 * Driving or disturbing that line holds the external switch in reset, which is
	 * exactly the "breaks the switch" symptom. There is a second mechanism with the
	 * same effect: bgpio_set() writes the whole cached 32-bit DAT word, and the
	 * cache is snapshotted once in bgpio_init(), so ANY LED write on gpio1 rewrites
	 * bit 26 from that stale snapshot.
	 *
	 * The real WPS LED is <&gpio0 22>, ACTIVE_LOW — a different bank entirely, so
	 * both the off-by-one and the shared-DAT-word hazard go away. Decoded from
	 * gpiom.ko `dev_leds` (file offset 0x3150, stride 20) and confirmed by
	 * dev_led_init_hook calling rtl819x_gpio_register_led(22, active_low=1) ->
	 * gpio_request_one(22, GPIOF_OUT_INIT_HIGH|GPIOF_EXPORT), i.e. initialised HIGH
	 * = off, driven LOW to light.
	 *
	 * Conflict check (the reason this is safe to enable): the pins that drive the
	 * external switch are gpio0 18 (SMI MDC), gpio0 19 (SMI MDIO) and gpio1 26
	 * (8367S reset). None of the nodes here touch any of them.
	 *
	 * Only WPS is here because it is the ONLY software-controllable LED on this
	 * board. LAN/WAN/Internet are driven by the switch/PHY LED controller (stock
	 * writes a pattern into bits [11:8] of 0xB8003504, not the GPIO DAT register)
	 * and the power LED has no GPIO at all — its libdhal.so entry points are
	 * do-nothing stubs. Two 2.4 GHz WLAN LED candidates exist (<&gpio1 1> and
	 * <&gpio0 24>) but the stock code selects between them on a chip-ID test that
	 * could not be resolved for this board, so they are NOT declared here.
	 *
	 * ⚠ Still needs one visual check: the pin and polarity are confirmed from the
	 * binary, but the panel COLOUR in the label is assumed to be green.
	 */
	gpio-leds {
		compatible = "gpio-leds";

		wps {
			label = "dir842:green:wps";
			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;	/* vendor 22 */
		};
	};

	/* External RTL8367S 5-port gigabit switch, managed over bit-banged SMI
	 * (MDC=GPIO18, MDIO=GPIO19 on gpio0). Hardware-confirmed: the RGMII uplink
	 * to the SoC is the switch's EXT1 (port 6, forced 1000/full, flow-control)
	 * — NOT EXT0. cpu_port = 6 so the driver's per-port VLANs bridge each jack
	 * to the live uplink. WAN jack = port 4, LAN jacks = ports 0-3. The RGMII
	 * itself is left in its (working) power-on config — the 8367S ext-interface
	 * registers differ from the 8367R-VB, so the driver skips extif/reset for
	 * this chip (see rtl8367b_is_8367s); extif1 is kept only for documentation. */
	rtl8367b {
		compatible = "realtek,rtl8367b";
		cpu_port = <6>;
		realtek,extif1 = <1 0 1 1 1 1 1 1 2>;
		gpio-sck = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		gpio-sda = <&gpio0 19 GPIO_ACTIVE_HIGH>;
	};

};

/* R4/G2: enable the on-SoC 2.4 GHz WMAC so the bring-up driver can probe it.
 * See RTL8197F.dtsi for the full decode (base 0x18640000, IRQ 6, and the
 * SR+0x64 enable gate). ⚠ This does NOT give you 2.4 GHz WiFi yet: the driver
 * probes the block, lifts the gate and verifies the register window responds,
 * but performs no PHY/RF init and does not register with mac80211. It is safe
 * to leave enabled — pcie1, which shares cpuintc IRQ 6, stays disabled. */
&wmac {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&spi0 {
	status = "okay";

	m25p80@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <41000000>;

		/* DIR-842 stock flash map (matches the RTL8197F v3.4.11B loader,
		 * which scans 0x10000..0x40000 and boots the cr6b blob at 0x40000):
		 * boot(128K) + MAC(64K) + config(64K), then the kernel+rootfs
		 * firmware region at 0x40000. boot+MAC are read-only (sacred loader
		 * and per-device MAC/RF-calibration). */
		partition@0 {
			label = "boot";
			reg = <0x0 0x20000>;
			read-only;
		};

		partition@20000 {
			label = "MAC";
			reg = <0x20000 0x10000>;
			read-only;
		};

		partition@30000 {
			label = "config";
			reg = <0x30000 0x10000>;
		};

		partition@40000 {
			label = "firmware";
			reg = <0x40000 0x7b0000>;
		};
	};
};
