#!/bin/sh

. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update
board=$(cat /tmp/sysinfo/board_name)

# R3: this used to say "eth0" "eth1". There IS no eth1 on the DIR-842 R1 — the SoC has a
# single CPU-port netdev and Linux splits it into eth0.2 (LAN, VID2) / eth0.1 (WAN, VID1).
# The phantom eth1 had a real consequence: config_generate emitted a wan_eth1_dev device
# section and hung the per-unit WAN MAC off a device that never appears, so eth0.1 silently
# inherited eth0's (LAN) MAC. The ASIC programs its WAN netif from eth0.1's live MAC and
# rewrites HW-routed egress src to it, so LAN==WAN MAC breaks the LAN=WAN+1 invariant and
# blackholes CPU<->WAN traffic while HW-routed frames still work. Name the real devices.
ucidef_set_interfaces_lan_wan "eth0.2" "eth0.1"

lan_mac=""
wan_mac=""

case $board in
  dir-815-d1)
    offset=$(strings -t x "$(find_mtd_part boot)" | grep llconfig | head -n 1 | awk '{ print "0x"$1 }')
    offset=$((offset+53))
    wan_mac=$(mtd_get_mac_binary boot $offset)
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  re708-v1)
    wan_mac=$(mtd_get_mac_binary boot 131079)
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  gwr1200ac-v1)
    # DIR-842 R1: the mtd1 "MAC" partition carries TWO overlaid schemas.
    #   0x00: D-Link per-unit base MAC as an 17-byte ASCII string ("e0:1c:fc:51:c9:ee")
    #         = the WAN MAC; LAN = WAN + 1. This is what stock uses (libhwdata.so).
    #   0x13: the Realtek vendor DEFAULT binary macAddr[] block (00:e0:4c:81:96:c1..c8),
    #         identical on every unit.
    # We used to read offset 19 (=0x13), i.e. the shared Realtek default, so every board
    # came up with the same MAC. Read the ASCII field instead and fall back to the old
    # behaviour if it is missing/garbage (some units may have an unprogrammed partition).
    # Currently reads the Realtek DEFAULT block (offset 19), i.e. the MAC that is
    # identical on every unit. Reading the per-unit ASCII MAC at 0x00 is what stock
    # does and is the correct end state.
    #
    # ⚠ It was reverted to this during a bisect of an apparent datapath regression
    # (100% loss on every path). That regression was NOT REAL: the test harness ran
    # `ip neigh flush` on the host immediately before each ping, recreating the
    # cold-unicast condition from task #13 (ASIC L2 entries start empty; cold
    # unicast is not delivered until traffic has flowed). The same box measured 0%
    # loss on 56 B, 1400 B and the NAT path once traffic had warmed the tables. So
    # the per-unit MAC is NOT known to break anything — that finding is retracted.
    #
    # It is still left reverted here for a different and unrelated reason, which
    # does stand: applying the per-unit MAC from userspace is non-deterministic
    # (/dev/mtd1 is not reliably readable that early, and one boot came up on the
    # real MAC while an identical later boot came up on the fallback). Doing it
    # properly means setting the MAC BEFORE userspace — a DT nvmem-cell on the MAC
    # partition, or a preinit hook — not from board.d/uci-defaults. See
    # uci-defaults/99-dir842-m5.
    wan_mac=$(mtd_get_mac_binary MAC 19)
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  gwr1200ac-v2)
    wan_mac=$(mtd_get_mac_binary boot 131091)
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  actionrg1200-v1 | \
  actionrf1200-v1)
    wan_mac=$(mtd_get_mac_ascii boot HW_NIC0_ADDR)
    lan_mac=$(macaddr_add "$wan_mac" 1)
    ;;
  gwr-300n-v1)
    wan_mac=$(mtd_get_mac_binary boot 24595)
    lan_mac=$(mtd_get_mac_binary boot 24583)
    ;;
  re172-v1)
    wan_mac=$(mtd_get_mac_binary boot 24583)
    lan_mac=$(mtd_get_mac_binary boot 24595)
esac

[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac

board_config_flush

exit 0
