#!/bin/sh
# DIR-842 R1 (RTL8197F) — intentionally empty.
#
# R4: the ASIC datapath bring-up that used to run inline here is owned by the ordered,
# idempotent service /etc/init.d/dir842-asic (S97, baked into the image: MAC poll ->
# swconfig apply -> fabric_reset 3 -> gw_prog -> L2 warm -> hwnat on). The inline copy
# existed because invoking the service from here "produced no effect" — root cause
# (2026-08-16): the script shipped 644, so exec'ing it always failed with a silent
# "Permission denied", while this file, being SOURCED by /etc/init.d/done, ran
# regardless. With the execute bit fixed the service runs from its own rc.d symlink
# and the duplicate is gone.
#
# Recovery for a wedged datapath: /etc/init.d/dir842-asic restart
exit 0
