#!/bin/sh
# DIR-842 R1 (RTL8197F) — default first-boot bring-up for the OpenWrt port.
#
# Brings up a LAN bridge on eth0 and a working 5 GHz AP on the on-board
# RTL8822BE (rtw88 over PCIe — this is the chip's primary band; 2.4 GHz on it
# is a weak secondary path). The RTL8822BE efuse is BLANK on this board, so a
# kernel patch (mac80211 patches/realtek/04-) assigns a random MAC if none is
# set; here we also pin a stable locally-administered MAC for a deterministic
# BSSID. Real gateway config (WAN, real SSID/PSK, firewall zones) belongs in
# the private profile overlay (dir842-profile), layered at build time via
# PROFILE=. There is no managed WAN port yet (see docs/ASSESSMENT.md), so the
# default wan interface is removed to avoid netifd errors.

# --- M6.6 HW-routing cascade (VID-based, no CPU-tag). The SoC ASIC classifies
# LAN vs WAN purely by 802.1Q VID over the tagged trunk (port6); rtl865x_start +
# /proc/rtl865x_gw use VID2=LAN / VID1=WAN. ★ GOTCHA (cost a long debug): the
# rtl8367b swconfig driver IGNORES the `vid=` attribute and uses vid = (vlan
# index), so vlan '1' => 8367S VID1 and vlan '2' => VID2. The 8367S MUST therefore
# be VID1 = WAN (jack4 = tiny) and VID2 = LAN (jacks 0-3; hal is on jack2) to match
# the SoC — backwards routes WAN frames onto the LAN jacks and NOTHING reaches the
# WAN peer (found via the rtl8367b debugfs vlan_mc dump). Trunk port6 tagged in
# both. Linux splits the CPU port into eth0.2 (LAN VID2) / eth0.1 (WAN VID1).
# --- R3: per-unit MACs from flash -------------------------------------------------
# mtd1 ("MAC", flash 0x20000) holds the D-Link per-unit base MAC as a 17-byte ASCII
# string at offset 0 (this is what stock reads via libhwdata.so). That base IS the WAN
# MAC; LAN = base + 1. Anything else on that partition (the Realtek macAddr[] block at
# 0x13) is a vendor default shared by every unit — reading it, as this port used to,
# gives every board the same MAC.
# Fall back to the old Realtek default pair if the field is unprogrammed/garbage so the
# box still comes up consistently with what gw_prog's fallback constants expect.
. /lib/functions.sh
. /lib/functions/system.sh
# ⚠ KNOWN LIMITATION — read this before "fixing" it again.
# Reading the per-unit MAC here does NOT work reliably: at uci-defaults time /dev/mtd1 is
# not consistently readable yet, so the `dd` silently returns nothing and the fallback is
# used. Worse, the failure is NON-DETERMINISTIC — one boot came up with the real per-unit
# MACs (e0:1c:fc:51:c9:ef / :ee, confirmed also programmed into the ASIC netif) and a later
# identical boot came up on the fallback. Since gw_prog copies whatever MAC the interface
# has at that moment into the ASIC netif, a half-applied MAC is worse than a fixed one: if
# Linux and the ASIC disagree the datapath blackholes entirely.
# So: pin the deterministic pair for now. The ASCII per-unit MAC in mtd1+0x00 is real and
# board.d/02_network reads it correctly for board.json; wiring it end-to-end needs the MAC
# to be set BEFORE userspace — i.e. from the DT (an nvmem-cell on the MAC partition, if
# 4.14's mtd exposes one here) or an early preinit hook — not from uci-defaults.
DIR842_WAN_MAC='00:e0:4c:81:96:c3'
DIR842_LAN_MAC='00:e0:4c:81:96:c2'

# NOTE: this heredoc is deliberately UNQUOTED (<<EOF, not <<'EOF') so the two MAC
# variables above expand. Keep any literal '$' out of this block.
uci -q batch <<EOF
add network switch
set network.@switch[-1].name='switch0'
set network.@switch[-1].reset='1'
set network.@switch[-1].enable_vlan='1'
add network switch_vlan
set network.@switch_vlan[-1].device='switch0'
set network.@switch_vlan[-1].vlan='1'
set network.@switch_vlan[-1].vid='1'
set network.@switch_vlan[-1].ports='4 6t'
add network switch_vlan
set network.@switch_vlan[-1].device='switch0'
set network.@switch_vlan[-1].vlan='2'
set network.@switch_vlan[-1].vid='2'
set network.@switch_vlan[-1].ports='0 1 2 3 6t'
set network.lan.ifname='eth0.2'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.0.1'
set network.lan.netmask='255.255.255.0'
delete network.lan.ip6assign
# ★ Pin the LAN MAC to the ASIC's LAN netif MAC (gw_prog GW_MAC_LAN = ...c2). The
# eth driver falls back to a RANDOM MAC when DT provides none, so on a fresh boot
# LAN clients would ARP-resolve 192.168.0.1 to the random MAC — which never matches
# ASIC netif[0], so the outbound hardware path silently never engages (everything
# traps to the CPU). Same failure class as the wan.macaddr pin below, LAN side.
# R3: no longer a hardcoded Realtek default — set from the PER-UNIT MAC in flash
# ($DIR842_LAN_MAC, computed above from mtd1+0x00). gw_prog reads the live netif MACs via
# gw_netif_mac() and programs the ASIC to match, so the two datapaths stay consistent.
set network.lan.macaddr="$DIR842_LAN_MAC"
set network.wan='interface'
set network.wan.ifname='eth0.1'
set network.wan.proto='static'
set network.wan.ipaddr='172.16.0.1'
set network.wan.netmask='255.255.255.0'
delete network.wan6
# ★ M6.6 Phase 3 CRITICAL: pin eth0.1's MAC to the ASIC's WAN netif MAC. gw_prog
# programs the WAN L3 interface with GW_MAC_WAN = LAN-MAC+1 = ...c3, and the ASIC
# rewrites HW-routed egress frames' src MAC to c3. But eth0.1 is a VLAN that inherits
# eth0's ...c2, so CPU-path (software-masqueraded / box-originated) WAN frames go out
# as c2 while the WAN peer's ARP + all HW-routed frames use c3. That mismatch silently
# blackholes EVERY CPU<->WAN packet (the miss-path handshake, ICMP, box-originated),
# while HW-routed traffic works — which is exactly the confusing failure it caused.
# Aligning eth0.1 to c3 makes the software and hardware datapaths agree.
# R3: per-unit WAN MAC = the flash base MAC ($DIR842_WAN_MAC). This MUST stay exactly
# LAN-1 (equivalently LAN = WAN+1): the ASIC programs its WAN netif from eth0.1's live MAC
# and rewrites HW-routed egress src to it, so if the software and hardware MACs disagree
# every CPU<->WAN packet blackholes while HW-routed traffic still works — a genuinely
# confusing failure mode. eth0.1 is a VLAN of eth0 and would otherwise inherit the LAN MAC.
set network.wan.macaddr="$DIR842_WAN_MAC"
commit network
EOF

# --- M6.6 Phase 3: firewall + flow-offload. The default zones already ACCEPT
# lan->wan and masquerade the wan zone (SRC -> 172.16.0.1, which is exactly the
# ASIC extIP[0] the hwnat rows rewrite to). Enable software flow offloading and, on
# top of it, HARDWARE offload: that emits the `-j FLOWOFFLOAD --hw` FORWARD rule that
# actually drives our ndo_flow_offload hooks. nf_conntrack_acct gives per-flow byte/
# packet counters so Phase 4 can watch them FREEZE when the ASIC takes over a flow.
uci -q batch <<'EOF'
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='1'
commit firewall
EOF

# --- 5 GHz AP on the PCIe RTL8822BE (rtw88); 2x2 VHT80. hwmode 11a = 5 GHz on
#     this 4.14-era netifd. country BR unlocks the UNII-1 channels for beaconing
#     (world/'00' marks them no-IR). macaddr set because the efuse is blank. ---
uci -q batch <<'EOF'
delete wireless
set wireless.radio0='wifi-device'
set wireless.radio0.type='mac80211'
set wireless.radio0.hwmode='11a'
set wireless.radio0.channel='36'
set wireless.radio0.htmode='VHT80'
set wireless.radio0.country='BR'
# ★ radio stays DISABLED by default, and this is deliberate — do not "fix" it again.
# R3 briefly set this to '0'. Result, measured: the box HANGS during rtw88 bring-up. The
# boot log shows `write RF mode table fail` + a WARN from `iw` (rtw88_8822be), then the
# console goes silent and every datapath reads 100% packet loss — which is easy to
# misdiagnose as a switch/ASIC regression, because that is exactly what it looks like.
# Cause is the BLANK EFUSE on this board: rtw88 has no RF cal to program. The real fix is
# R3's remaining item — feed the calibration from mtd1 (5 GHz tables at 0x171/0x235) and
# use RFE type 0 as stock does, instead of our patch's forced RFE 2 — after which this can
# be flipped to '0'. Until then bring WiFi up by hand when you want it:
#     uci set wireless.radio0.disabled=0 && wifi up
set wireless.radio0.disabled='1'
set wireless.default_radio0='wifi-iface'
set wireless.default_radio0.device='radio0'
set wireless.default_radio0.network='lan'
set wireless.default_radio0.mode='ap'
set wireless.default_radio0.ssid='DIR842-OpenWrt'
# R3 security: ship the radio UNCONFIGURED-open-less, i.e. with NO pre-shared key.
# The previous default baked the literal PSK 'dir842wifi' into every image, which is
# a published credential — anyone with the firmware knows it. OpenWrt's own
# convention is `encryption=none` + no key until the operator sets one, and LuCI
# (added in R5) prompts for it on first login. Do NOT re-add a default key.
set wireless.default_radio0.encryption='none'
delete wireless.default_radio0.key
# macaddr: the RTL8822BE efuse is blank so rtw88 invents a RANDOM MAC every boot
# (see the boot log: "efuse MAC invalid, using random ..."). A fixed
# locally-administered address at least makes the BSSID stable across reboots.
# Proper fix (R3, pending): derive it from the per-unit MAC in mtd1+0x00, which is
# where stock keeps it — see docs/VENDOR-PARITY-INVENTORY.md.
set wireless.default_radio0.macaddr='02:11:22:33:44:56'
commit wireless
EOF

# --- Force BROADCAST DHCP offers. The box->client UNICAST offer to a just-learned
#     client MAC is not reliably delivered (box-originated cold-unicast, task #13 /
#     the RGMII-trunk L2-lookup egress); broadcast offers DO get through. OpenWrt's
#     `option dhcpbroadcast` only emits the tag-conditional
#     `dhcp-broadcast=tag:needs-broadcast`, which does NOT cover normal clients — so
#     drop the UNCONDITIONAL raw option into /etc/dnsmasq.conf, which dnsmasq reads
#     as an extra conf-file (see dnsmasq.init). Ref: docs/M7-LARGE-FRAME-RX-WEDGE.md.
grep -qx 'dhcp-broadcast' /etc/dnsmasq.conf 2>/dev/null || echo 'dhcp-broadcast' >> /etc/dnsmasq.conf

exit 0

# R3: enable the ordered ASIC bring-up service (replaces the old rc.local race)
/etc/init.d/dir842-asic enable 2>/dev/null
