#!/bin/sh
# ★ Run ONCE per virgin overlay. Every sysupgrade rewrites the firmware partition,
# which holds rootfs_data, so the overlay whiteout that marked this seed "done" is
# erased and uci_apply_defaults sources it again on the next boot -- even on a
# config-PRESERVING sysupgrade, where the preserved config is restored in preinit
# and this seed then ran on top of it: LAN back to 192.168.0.1, WAN back to DHCP
# (killing a PPPoE WAN), duplicate `switch`/`switch_vlan` sections appended, and an
# OPEN `DIR842-OpenWrt` 5 GHz AP re-seeded over the user's SSID/PSK. (Found by
# review, 2026-09-02.) 09_ and 10_ already gate themselves; this marker does the
# same here. It lives in `system`, which `sysupgrade` preserves and a `-n` flash
# regenerates, so: preserved config -> skip; clean flash -> seed.
# (Cannot key on wireless.radio0: 10_wireless-5g-ifname runs `wifi config` first.)
[ "$(uci -q get system.@system[0].dir842_m5_seeded)" = "1" ] && exit 0
# DIR-842 R1 (RTL8197F) — default first-boot bring-up for the OpenWrt port.
#
# Brings up a LAN bridge on eth0 and a working 5 GHz AP on the on-board
# RTL8822BE (rtw88 over PCIe — this is the chip's primary band; 2.4 GHz on it
# is a weak secondary path). The RTL8822BE efuse is BLANK on this board, so a
# kernel patch (mac80211 patches/realtek/04-) assigns a random MAC if none is
# set; here we also pin a stable locally-administered MAC for a deterministic
# BSSID. Real gateway config (WAN, real SSID/PSK, firewall zones) belongs in
# the private profile overlay (dir842-profile), layered at build time via
# PROFILE=. The WAN port IS managed (eth0.1 on VID1, DHCP client by default) —
# an earlier revision of this comment said otherwise and cited a doc that has
# since been deleted for being wrong about exactly that.

# --- M6.6 HW-routing cascade (VID-based, no CPU-tag). The SoC ASIC classifies
# LAN vs WAN purely by 802.1Q VID over the tagged trunk (port6); rtl865x_start +
# /proc/rtl865x_gw use VID2=LAN / VID1=WAN. ★ GOTCHA (cost a long debug): the
# rtl8367b swconfig driver IGNORES the `vid=` attribute and uses vid = (vlan
# index), so vlan '1' => 8367S VID1 and vlan '2' => VID2. The 8367S MUST therefore
# be VID1 = WAN (jack4 = tiny) and VID2 = LAN (jacks 0-3; hal is on jack2) to match
# the SoC — backwards routes WAN frames onto the LAN jacks and NOTHING reaches the
# WAN peer (found via the rtl8367b debugfs vlan_mc dump). Trunk port6 tagged in
# both. Linux splits the CPU port into eth0.2 (LAN VID2) / eth0.1 (WAN VID1).
# --- R3: per-unit MACs from flash -------------------------------------------------
# mtd1 ("MAC", flash 0x20000) holds the D-Link per-unit base MAC as a 17-byte ASCII
# string at offset 0 (this is what stock reads via libhwdata.so). That base IS the WAN
# MAC; LAN = base + 1. Anything else on that partition (the Realtek macAddr[] block at
# 0x13) is a vendor default shared by every unit — reading it, as this port used to,
# gives every board the same MAC.
# Fall back to the old Realtek default pair if the field is unprogrammed/garbage so the
# box still comes up consistently with what gw_prog's fallback constants expect.
. /lib/functions.sh
. /lib/functions/system.sh
# ★ The MAC is NOT set here — board.d/02_network is the SINGLE source of truth.
# It reads the per-unit ASCII MAC from mtd1+0x00 and publishes it via board.json
# before netifd configures the interfaces. This file used to ALSO pin
# network.lan/wan.macaddr, and having two independent writers is exactly what made
# the MAC non-deterministic: some boots came up per-unit, identical later boots on
# the fallback, depending which won. Do not re-add a pin here.
# The driver follows automatically — gw_netif_mac() programs the ASIC netif from the
# interface's LIVE MAC, so the software and hardware datapaths cannot disagree.

# NOTE: this heredoc is UNQUOTED (<<EOF, not <<'EOF'). Nothing in it needs shell
# expansion any more (the MAC pins that once did were removed — see above), but
# it is left unquoted rather than churn a known-good block. ⚠ Consequence: keep
# any literal '$' out of this block, or quote the heredoc when you add one.
uci -q batch <<EOF
add network switch
set network.@switch[-1].name='switch0'
set network.@switch[-1].reset='1'
set network.@switch[-1].enable_vlan='1'
add network switch_vlan
set network.@switch_vlan[-1].device='switch0'
set network.@switch_vlan[-1].vlan='1'
set network.@switch_vlan[-1].vid='1'
set network.@switch_vlan[-1].ports='4 6t'
add network switch_vlan
set network.@switch_vlan[-1].device='switch0'
set network.@switch_vlan[-1].vlan='2'
set network.@switch_vlan[-1].vid='2'
set network.@switch_vlan[-1].ports='0 1 2 3 6t'
set network.lan.ifname='eth0.2'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.0.1'
set network.lan.netmask='255.255.255.0'
delete network.lan.ip6assign
set network.wan='interface'
set network.wan.ifname='eth0.1'
# WAN is a DHCP client — the default any router should ship with, so the box
# routes as soon as a modem/uplink is plugged into the Internet jack. Change it
# to PPPoE (or static) in LuCI for ISPs that need it.
#
# ★ This used to be a static 172.16.0.1/24 (the bench WAN peer's subnet). That is
# a lab artifact, not a sane default: a user who flashed and plugged in a modem
# got no internet and no explanation. The bench sets it explicitly instead —
# see bench-up.sh.
#
# Hardware offload is unaffected by a dynamic address: the ASIC's masquerade
# extIP[0] is (re)written from the LIVE WAN IP on every flow offload
# (rtl819x_hwnat.c -> rtl865x_set_wan_extip), and a changed identity flushes the
# rows programmed under the old one. RTL865X_WAN_EXTIP is only a boot-time
# placeholder.
set network.wan.proto='dhcp'
delete network.wan.ipaddr
delete network.wan.netmask
delete network.wan6
# ★ MAC constraint that still matters, even though nothing here sets a MAC:
# WAN must be exactly LAN-1 (equivalently LAN = WAN+1). gw_prog programs the ASIC's
# WAN netif from eth0.1's LIVE MAC and rewrites HW-routed egress frames' source to
# it. eth0.1 is a VLAN of eth0 and would otherwise just inherit the LAN MAC, so if
# the software and hardware MACs disagree, every CPU<->WAN packet blackholes (the
# miss-path handshake, ICMP, anything box-originated) while HW-routed traffic keeps
# working — a genuinely confusing failure mode that cost real debugging time.
# board.d/02_network satisfies this: it derives lan = wan + 1 from the single
# per-unit base MAC in mtd1+0x00 and publishes BOTH via board.json.
commit network
EOF

# --- M6.6 Phase 3: firewall + flow-offload. The default zones already ACCEPT
# lan->wan and masquerade the wan zone (SRC -> whatever the WAN's live local IP is,
# which is exactly what the ASIC's extIP[0] is programmed to, per flow).
# Enable software flow offloading and, on
# top of it, HARDWARE offload: that emits the `-j FLOWOFFLOAD --hw` FORWARD rule that
# actually drives our ndo_flow_offload hooks. nf_conntrack_acct gives per-flow byte/
# packet counters so Phase 4 can watch them FREEZE when the ASIC takes over a flow.
uci -q batch <<'EOF'
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='1'
commit firewall
EOF

# macaddr: the RTL8822BE efuse is blank, so rtw88 invents a RANDOM MAC every boot
# ("efuse MAC invalid, using random ..." in the log) — a different BSSID on every
# reboot, which is exactly what R3 asked to stop.
# R3: derive it from the PER-UNIT base MAC in mtd1+0x00 (base+2, keeping base+0 =
# WAN and base+1 = LAN as board.d assigns them), so the BSSID is stable AND unique
# per unit. Falls back to a fixed locally-administered address if the field is
# unprogrammed, so the radio still comes up deterministically.
#
# Unlike the ethernet MACs, reading mtd1 here is safe: this only sets the WiFi
# BSSID. It is NOT a second writer for the ethernet MAC (board.d remains the sole
# source for those, see above), so it cannot reintroduce the ASIC-vs-Linux mismatch
# that a competing ethernet-MAC writer caused.
DIR842_BASE_MAC=$(dd if=/dev/mtd1 bs=1 count=17 2>/dev/null)
case "$DIR842_BASE_MAC" in
[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F])
	DIR842_WIFI_MAC=$(macaddr_add "$DIR842_BASE_MAC" 2) ;;
*)
	DIR842_WIFI_MAC='02:11:22:33:44:56' ;;
esac
logger -t dir842 "wifi BSSID MAC: $DIR842_WIFI_MAC"

# --- R3: per-unit crystal cap for the blank-efuse RTL8822BE ------------------------
# This board's 8822BE efuse is blank, so rtw88 falls back to crystal_cap = 0 — the
# MINIMUM load capacitance, not this unit's calibrated value. That mistunes the RF
# synthesiser badly enough that RF registers stop answering, which surfaces as
# `write RF mode table fail` and a hung bring-up (see the radio0.disabled note below).
#
# The calibrated value lives in the read-only "MAC" partition. mtd1+0x13e is the byte
# that works on this unit (39); the surrounding bytes 0x13e..0x141 = 39,49,35,24 are
# two plausible 6-bit xcap values and two inside the vendor's 7..50 thermal range, and
# the field ORDER was never resolved from the binary — 0x13e is EMPIRICAL, confirmed by
# the radio initialising cleanly with it. If a future unit fails to bring the radio up,
# sweep the other candidates:
#     echo N > /sys/module/rtw88_core/parameters/xtal_cap_override
#     rmmod rtw88_8822be; modprobe rtw88_8822be; wifi up
#
# Written as a modprobe option so it applies before rtw88 probes on every subsequent
# boot; the module is also reloaded here so it takes effect on THIS boot.
# NB: `hexdump` (/usr/bin/hexdump) IS in this image; `od` is NOT. I had that backwards
# once and "fixed" a working line into a broken one — the missing tool yields an empty
# string, which falls silently into the fallback branch and looks like a flash-read
# failure. Verified on the box: dd reads mtd1 fine and this pipeline returns 39.
DIR842_XCAP=$(dd if=/dev/mtd1 bs=1 skip=318 count=1 2>/dev/null | hexdump -e '"%d"')
case "$DIR842_XCAP" in
[0-9]|[1-5][0-9]|6[0-3])
	mkdir -p /etc/modprobe.d
	echo "options rtw88_core xtal_cap_override=$DIR842_XCAP" > /etc/modprobe.d/10-rtw88-xtal.conf
	logger -t dir842 "rtw88 crystal_cap from flash: $DIR842_XCAP"
	# apply on this boot too (efuse info is read at probe, so the module must re-probe)
	if [ -d /sys/module/rtw88_8822be ]; then
		rmmod rtw88_8822be 2>/dev/null
		sleep 1
		modprobe rtw88_8822be 2>/dev/null
	fi
	;;
*)
	logger -t dir842 "rtw88 crystal_cap: mtd1+0x13e unreadable/out of range ($DIR842_XCAP), leaving rtw88 default"
	;;
esac

# --- 5 GHz AP on the PCIe RTL8822BE (rtw88); 2x2, HT20 (see below). hwmode 11a = 5 GHz on
#     this 4.14-era netifd. country BR unlocks the UNII-1 channels for beaconing
#     (world/'00' marks them no-IR). macaddr set because the efuse is blank. ---
# ⚠ The batch below opens with `delete wireless` — KEEP AS-IS, it is a NO-OP and
#   that is load-bearing. Whole-config `uci delete wireless` (no section) is an
#   INVALID statement: "uci: Invalid argument", exit 1, deletes NOTHING — silent
#   under `-q batch` (measured on-box 2026-08-02; docs/WIFI-DUAL-BAND.md §9 item 6).
#   It has never wiped 09_'s radio1 seed. Do NOT "repair" it into working
#   per-section deletes: 09_ self-deletes after seeding, so a real radio1 wipe here
#   would ship a 5 GHz-only box on a virgin overlay. To reset only this radio:
#   delete wireless.radio0 / delete wireless.default_radio0.
uci -q batch <<'EOF'
delete wireless
set wireless.radio0='wifi-device'
set wireless.radio0.type='mac80211'
set wireless.radio0.hwmode='11a'
set wireless.radio0.channel='36'
# ★ HT20, NOT VHT80/VHT40 — measured on this unit 2026-09-01: at 80 MHz (and 40 MHz)
#   5 GHz clients associate and complete EAPOL but DHCP never finishes; wlan1 rx stays 0
#   and the station is dropped after exactly 4.03 s. At 20 MHz the same client gets an
#   IP and sustains data. The 5 GHz TX shortfall vs stock (~17 dB measured, split between
#   driver and regulatory NOT yet separated -- see docs/WIFI-DUAL-BAND.md) leaves the
#   link marginal; a 4x narrower channel is ~6 dB more SNR each way and is what tips it
#   over. ★ The cost is real: 2x2 HT20 tops out at 144 Mbit/s PHY, below what VHT80
#   managed on the boots where it worked at all. A working link beats a faster dead one.
#   Revisit if the RF shortfall is ever recovered. HT20 is a workaround, not a preference.
set wireless.radio0.htmode='HT20'
set wireless.radio0.country='BR'
# ★ R3 RESOLVED — the radio is ENABLED. It used to be forced off because bringing it up
# hung the box: rtw88 logged `write RF mode table fail` and the console went silent, which
# looked exactly like a switch/ASIC regression. That WARN comes from
# rtw8822b_config_trx_mode() (rtw8822b.c:811; NOT set_channel_bb as earlier notes said), which polls RF reg 0x33 for 0x00001
# a hundred times and never gets it — i.e. RF REGISTER ACCESS failing, NOT a missing power
# table as previously assumed.
# Root cause: this board's RTL8822BE efuse is blank, so rtw88 fell back to crystal_cap = 0
# (the MINIMUM load capacitance) instead of this unit's calibrated value. A mistuned
# crystal puts the RF synthesiser off-frequency, so the RF registers never answer.
# Fix: feed the per-unit crystal cap from the "MAC" mtd partition (see the modprobe.d
# stanza written below). Measured with it applied: no WARN, wlan1 reaches forwarding
# state, and `iw dev wlan1 info` reports an AP on channel 36 (width per htmode; HT20 since 3b5a56f), 17 dBm.
set wireless.radio0.disabled='0'
set wireless.default_radio0='wifi-iface'
set wireless.default_radio0.device='radio0'
set wireless.default_radio0.network='lan'
set wireless.default_radio0.mode='ap'
set wireless.default_radio0.ssid='DIR842-OpenWrt'
# R3 security: ship the radio UNCONFIGURED-open-less, i.e. with NO pre-shared key.
# The previous default baked the literal PSK 'dir842wifi' into every image, which is
# a published credential — anyone with the firmware knows it. OpenWrt's own
# convention is `encryption=none` + no key until the operator sets one, and LuCI
# (added in R5) prompts for it on first login. Do NOT re-add a default key.
set wireless.default_radio0.encryption='none'
delete wireless.default_radio0.key
EOF

uci -q batch <<EOF
set wireless.default_radio0.macaddr="$DIR842_WIFI_MAC"
commit wireless
EOF

# --- (R4, 2026-08-16) The old unconditional `dhcp-broadcast` dnsmasq option is GONE.
#     It was a Fork-A-era workaround: the box->client UNICAST offer to a just-learned
#     client MAC was not reliably delivered over the RGMII trunk (box-originated
#     cold-unicast, task #13), so offers were forced broadcast. Both halves flipped
#     since:
#       * the workaround became UNNECESSARY — with CPU-tag mode + per-jack L2 a fresh
#         random-MAC wired client leases fine on unicast offers (measured: macvlan
#         netns, DISCOVER->OFFER->ACK->bound);
#       * the workaround became HARMFUL — broadcast TX from the 5 GHz rtw88 AP is not
#         delivered (client associates, unicast data flows, but every broadcast OFFER
#         vanishes), so 5 GHz clients could never complete DHCP. Removing it fixed
#         5 GHz DHCP on the spot (measured on-box).
#     If a cold-unicast regression ever resurfaces, prefer `option dhcpbroadcast` per
#     host or fix the L2 path — do NOT bring the blanket option back, it re-breaks
#     5 GHz DHCP. Ref: docs/M7-LARGE-FRAME-RX-WEDGE.md (history), README (5 GHz).

# Mark this overlay as seeded (see the guard at the top).
uci -q set system.@system[0].dir842_m5_seeded='1'
uci -q commit system
exit 0

# (R4 note: no `enable` for dir842-asic here — it would be dead code below `exit 0`
# anyway, and none is needed: the image build bakes /etc/rc.d/S97dir842-asic for any
# init script with START= set. The R3-era line that sat here never ran once.)
