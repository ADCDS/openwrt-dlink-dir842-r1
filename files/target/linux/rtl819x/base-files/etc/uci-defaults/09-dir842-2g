#!/bin/sh
# DIR-842 R1 (RTL8197F) -- seed the on-SoC 2.4 GHz radio (vendor rtl8192cd,
# WEXT). Ported from openwrt-4.14's 09_wireless-dualband-dir842, the
# field-tested answer key for this exact board.
#
# `wifi config` only detects cfg80211 wiphys (ucode /lib/wifi/mac80211.uc
# walks /sys/class/ieee80211): the vendor driver registers a plain netdev with
# no wiphy at all, so it is structurally invisible to that path and has to be
# seeded here instead. Handler: lib/netifd/wireless/rtl8192cd.sh (shipped by
# the kmod-rtl8192cd package -- see modules.mk's coexistence-guard comment for
# why that file must never live in base-files/).
#
# Runs numbered before 10-dir842-5g-ifname and 99-dir842 on purpose: this only
# ever touches wireless.radio1 (a name the 4 GHz mac80211 detection walk skips
# straight past, since it always starts hunting for a free radioN at 0 -- see
# mac80211.uc's `while (config["radio"+idx]) idx++`), so it is safe regardless
# of whether the 5 GHz radio has been detected yet.
#
# This section is only ever ACTED on once kmod-rtl8192cd is actually in the
# image (still commented out of seed.config/seed-min.config as of M7 -- see
# docs/PORT-MAIN-6.18-STATUS.md §6). Until then it sits inert: no handler is
# registered for type='rtl8192cd', and netifd's config_parse_wireless_device()
# just skips a device type it has no handler for, without logging anything
# (confirmed in the handler's own top-of-file comment). Seeding it unattended
# now, rather than only once the kmod ships, keeps this script identical to
# the proven 4.14 original and avoids a second uci-defaults edit down the
# line for no real benefit.

# The driver ingests /etc/Wireless/RTL8192CD.dat on interface-up
# (8192cd_comapi.c:3431, called from 8192cd_osdep.c:7703). Stock symlinks this
# directory to /tmp so the file lands in tmpfs instead of causing a flash
# write on every `wifi up`; do the same.
[ -e /etc/Wireless ] || ln -s /tmp /etc/Wireless

[ -e /etc/config/wireless ] || touch /etc/config/wireless

# Only seed once.
uci -q get wireless.radio1 >/dev/null && exit 0

uci -q batch <<'EOF'
set wireless.radio1='wifi-device'
set wireless.radio1.type='rtl8192cd'
set wireless.radio1.hwmode='11g'
set wireless.radio1.channel='6'
set wireless.radio1.htmode='HT20'
# band = dot11BssType.net_work_type, a BITMASK (8192cd.h enum NETWORK_TYPE):
#   WIRELESS_11B=BIT(0)=1  WIRELESS_11G=BIT(1)=2  WIRELESS_11A=BIT(2)=4
#   WIRELESS_11_24N=BIT(3)=8   =>  WIRELESS_MODE_24G = 1|2|8 = 11
# NOT '7' (=11b|11g|11a): that asks a 2.4 GHz-only radio for 5 GHz OFDM and
# drops 11n entirely. 11 is also the value the 4.14 bring-up that actually
# associated a client used ("wlan0_band=11").
set wireless.radio1.band='11'
set wireless.radio1.country='1'
set wireless.radio1.disabled='0'

set wireless.default_radio1='wifi-iface'
set wireless.default_radio1.device='radio1'
set wireless.default_radio1.network='lan'
set wireless.default_radio1.mode='ap'
set wireless.default_radio1.ssid='DIR842-2G'
# Open on purpose, same stance as the 5 GHz seed in 99-dir842: a passphrase
# baked into a published image is a published credential. Set
# encryption='psk2' + key before this touches a real network. (In-kernel
# WPA2-PSK is real here, not a gap: 8192cd_psk.c, enabled whenever the driver
# is built without RTK_NL80211, which this port's build is.)
set wireless.default_radio1.encryption='none'
commit wireless
EOF

exit 0
