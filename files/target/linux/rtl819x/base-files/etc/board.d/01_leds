#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update
board=$(board_name)

case $board in
dlink,dir-842-r1)
	# The only software-controllable LED on this board. The LAN, WAN and
	# Internet indicators are driven by the switch's own link and activity
	# logic, and the power LED has no GPIO behind it at all.
	ucidef_set_led_default "wps" "WPS" "green:wps" "0"
	;;
esac

board_config_flush
