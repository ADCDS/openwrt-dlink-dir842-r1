#!/bin/sh

. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update
board=$(board_name)

case $board in
dlink,dir-842-r1)
	ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"

	# The mtd1 "MAC" partition carries TWO overlaid schemas:
	#   0x00: the D-Link per-unit base MAC as a 17-byte ASCII string
	#         ("e0:1c:fc:51:c9:ee") = the WAN MAC; LAN = WAN + 1. This is
	#         what the stock firmware uses.
	#   0x13: the Realtek vendor DEFAULT binary block, identical on every unit.
	# Reading the binary field gives every board the same MAC, so read the
	# ASCII field and fall back only if it is missing or malformed.
	#
	# ★ THIS IS THE SINGLE SOURCE OF TRUTH FOR THE MAC — do not add a second
	# one. An earlier revision also pinned the addresses from uci-defaults, and
	# two independent writers is what made the MAC non-deterministic across
	# otherwise identical boots. board.d runs before netifd configures the
	# interfaces, which is why it belongs here.
	wan_mac=$(dd if=/dev/mtd1 bs=1 count=17 2>/dev/null)
	case "$wan_mac" in
	[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]) ;;
	*) wan_mac=$(mtd_get_mac_binary MAC 19) ;;
	esac
	lan_mac=$(macaddr_add "$wan_mac" 1)

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	;;
esac

board_config_flush
