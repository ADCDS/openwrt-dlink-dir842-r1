#!/bin/sh /etc/rc.common
# DIR-842 R1 (RTL8197F) — bring the ASIC hardware datapath up at boot, in order.
#
# The order is the whole point of this file. Each step below was measured on the
# 4.14 port (docs/HWNAT-OFFLOAD.md §8, "Boot ritual") and every one of them still
# applies under DSA:
#
#   0. MAC poll — gw_prog copies the CURRENT netdev MACs into the ASIC netifs. Run
#      it before netifd has applied the per-unit flash MACs and the ASIC keeps the
#      fallback constants while Linux moves on; an ASIC-vs-Linux netif MAC mismatch
#      blackholes the datapath completely.
#   1. fabric_reset 3 — MEASURED-REQUIRED: without it a fresh boot forwards NOTHING
#      (100% loss on every path, despite links up, correct VLANs and a gw_prog
#      readback that says PASS). Level 3 is engine reinit + CPUICR soft reset +
#      full fabric reset, and it re-arms the gw tables in-kernel, which is why
#      gw_prog must FOLLOW it.
#   2. gw_prog (/proc/rtl865x_gw) — netifs, routes, L2 nexthops, ACL ranges, and
#      MSCR EN_L3|EN_L4|EN_IN_ACL. Without it the switch core is EN_L2 only: it
#      bridges, but it does no L3 or L4 processing, so hardware NAT rows can be
#      installed perfectly and never be looked at.
#      ★ This WIPES the ASIC L2 tables, so the warm-up MUST come after it.
#   3. warm — the ASIC L2/ARP entries start empty, and cold unicast is not
#      delivered until traffic has flowed. A few box-originated pings prime them;
#      without this a freshly booted box reads as 100% packet loss.
#   4. hwnat on — LAST, strictly after the warm. Arming against cold tables kills
#      the datapath outright (measured).
#
# The 4.14 sequence opened with `swconfig dev switch0 set apply 1` to clear a
# wedged trunk->jack forwarding state in the external RTL8367S. There is no
# swconfig under DSA and no userspace equivalent; the switch driver programs that
# state at probe.
#
# 2026-09-04, SSH-at-boot fix: dropbear (S19) is already listening by the time
# this script (S97) runs, so a slow first `ssh` on a cold boot is this script
# (plus asic-wifi-settle, S99) hogging the single 500 MHz core while dropbear's
# banner/KEX tries to run. Two changes here address that:
#   - This whole script renices itself (see the top of start()) so the CFS
#     scheduler favors a concurrent SSH handshake over our own polling/ioctl
#     work. Pure scheduling-priority change, zero effect on what gets programmed
#     or in what order.
#   - `dir842.asic.fast_boot` (default OFF) would let fabric_reset use level 1
#     (engine-only) instead of level 3 at cold boot. It is NOT enabled by
#     default and should not be enabled without re-running the forwarding bench
#     first: level 3 is the MEASURED-REQUIRED path documented immediately below
#     (100% loss on every path without it) and that finding has NOT been
#     retested since. The knob exists so a lighter path can be tried and
#     reverted without editing this file. See asic_program() for the guard.
START=97

asic_warm_hosts() {
	local h
	[ -n "$WARM_HOSTS" ] && { echo "$WARM_HOSTS"; return; }
	h="$(uci -q get dir842.asic.warm_hosts)"
	[ -n "$h" ] && { echo "$h"; return; }
	echo "192.168.0.2 172.16.0.2"
}

# Router or bridge. Everything gw_prog programs is meaningless on a bridged AP,
# and one side effect is actively harmful there: gw_prog sets TEACR bit 0, which
# FREEZES L2/ARP aging. That protects the static nexthop chain in the router
# datapath; on a bridge it turns a transient wrong L2 row into a permanent one.
# ⚠ Switching router->bridge needs a REBOOT: nothing clears the aging freeze.
asic_role() {
	local r
	r="$(uci -q get dir842.asic.role)"
	case "$r" in
	router|bridge) echo "$r"; return ;;
	esac
	if uci -q get network.wan >/dev/null 2>&1; then echo router; else echo bridge; fi
}

wait_netif() {
	local i=0
	while [ $i -lt 40 ]; do
		[ -e /sys/class/net/br-lan/address ] && [ -e /sys/class/net/wan/address ] && break
		i=$((i + 1))
		sleep 1
	done
	sleep 2
}

asic_program() {
	if [ "$ROLE" = "router" ]; then
		# ⚠ fast_boot is an OPT-IN, OFF-BY-DEFAULT escape hatch for re-testing
		# whether a cold boot really needs level 3. It is NOT a validated fast
		# path: the last time this was measured, level 1 alone left the box
		# forwarding NOTHING (see the file header and docs/HWNAT-OFFLOAD.md
		# §8). Only turn it on to re-run that experiment on your own bench,
		# with full forwarding verification before trusting a boot with it on:
		#   uci set dir842.asic.fast_boot='1'; uci commit dir842
		# Revert with fast_boot='0' (or delete the option) if forwarding breaks.
		if [ "$(uci -q get dir842.asic.fast_boot)" = "1" ]; then
			logger -t dir842-asic "fast_boot=1: using fabric_reset=1 (engine reinit only), NOT the proven fabric_reset=3 -- unverified, revert with 'uci set dir842.asic.fast_boot=0' if forwarding breaks"
			echo 1 > /sys/module/rtl819x/parameters/fabric_reset 2>/dev/null
			sleep 1
		else
			echo 3 > /sys/module/rtl819x/parameters/fabric_reset 2>/dev/null
			sleep 3
		fi
		cat /proc/rtl865x_gw >/dev/null 2>&1
	else
		logger -t dir842-asic "bridge role: skipping fabric reset and gw_prog (L2 aging left ENABLED)"
	fi
}

asic_warm() {
	local h i
	[ "$ROLE" = "router" ] || return 0
	for i in 1 2 3; do
		for h in $(asic_warm_hosts); do
			ping -c2 -W1 "$h" >/dev/null 2>&1
		done
		sleep 1
	done
}

start() {
	# SSH-at-boot fix (2026-09-04): drop this whole script's scheduling
	# priority so a concurrent dropbear banner/KEX (S19, already listening)
	# isn't starved by our polling loops and fabric_reset/gw_prog calls.
	# Children (the `echo`/`cat`/`ping`/`ubus` subshells below) inherit the
	# nice value at fork, so one renice here covers the whole script. This is
	# ONLY a CFS scheduling-priority change: it does not alter what gets
	# programmed, in what order, or how long any single step takes. No-op,
	# harmlessly, if this busybox build lacks the renice applet.
	command -v renice >/dev/null 2>&1 && renice -n 15 -p $$ >/dev/null 2>&1

	logger -t dir842-asic "bring-up starting"

	# Wait for the driver's programming interface rather than exiting if it is
	# not there yet. Returning early here is silent, and a silent skip leaves
	# the datapath without its fabric reset -- i.e. dead -- with nothing in the
	# log to say why. Observed on a cold flash boot: no log line at all.
	local i=0
	while [ $i -lt 30 ]; do
		[ -e /proc/rtl865x_gw ] && break
		i=$((i + 1))
		sleep 1
	done
	if [ ! -e /proc/rtl865x_gw ]; then
		logger -t dir842-asic "no /proc/rtl865x_gw after 30s - datapath driver missing, giving up"
		return 0
	fi

	# Let netifd apply the configuration BEFORE deciding the role. The heuristic
	# reads network.wan, and at S97 time on a cold boot that section may not be
	# in place yet -- which silently downgrades a router to bridge and skips the
	# fabric reset the datapath needs.
	ubus -t 60 wait_for network.interface.lan 2>/dev/null

	wait_netif
	ROLE="$(asic_role)"
	logger -t dir842-asic "role=$ROLE"
	asic_program
	asic_warm
	if [ "$ROLE" = "router" ]; then
		echo 1 > /sys/module/rtl819x/parameters/hwnat 2>/dev/null
	fi
	logger -t dir842-asic "datapath armed (role=$ROLE hwnat=$(cat /sys/module/rtl819x/parameters/hwnat 2>/dev/null))"
}

stop() {
	echo 0 > /sys/module/rtl819x/parameters/hwnat 2>/dev/null
	logger -t dir842-asic "offload disarmed"
}
