# DIR-842 R1 ASIC options.
#
# This file lives in /etc/config, which sysupgrade PRESERVES — unlike
# /etc/init.d. Configure here rather than editing the init scripts, or your
# changes vanish on the next flash.
config asic 'asic'
	# Peers pinged at boot to prime the ASIC L2 tables after gw_prog wipes
	# them. ROUTER ROLE ONLY — in bridge role nothing wipes the tables, so the
	# warm-up is skipped entirely and this option is unused.
	# Set these to hosts that actually answer on YOUR network; unreachable
	# ones just time out harmlessly.
	option warm_hosts '192.168.0.2 172.16.0.2'

	# Datapath role. Leave unset to auto-detect (router if a 'wan' interface
	# exists, else bridge). Set explicitly if the heuristic is wrong for you —
	# notably a dumb AP that still has a leftover 'wan' stanza, which would
	# otherwise be treated as a router and re-freeze the ASIC L2 aging.
	# option role 'bridge'

	# ⚠ Changing role router->bridge requires a REBOOT, not just a restart:
	# nothing in bridge role can clear the ASIC's frozen L2 aging (TEACR bit0).

	# Cold-boot fabric_reset level. Leave unset/'0' (the default): boot uses
	# the PROVEN level 3 (full fabric reset). Level 3 is not just cautious —
	# it is MEASURED-REQUIRED (see dir842-asic's header comment and
	# docs/HWNAT-OFFLOAD.md §8): a lighter level was tried and left the box
	# forwarding NOTHING despite links up and a passing gw_prog readback.
	# option fast_boot '1'
	#
	# Setting fast_boot='1' switches to level 1 (engine reinit only), which is
	# lighter and unblocks CPU for SSH sooner, but is UNVERIFIED at cold boot
	# since that last measurement. Only enable it to re-run that experiment
	# yourself, and confirm forwarding end-to-end (not just a gw_prog PASS)
	# before trusting a boot with it on. Revert by unsetting it or restoring
	# '0'.
