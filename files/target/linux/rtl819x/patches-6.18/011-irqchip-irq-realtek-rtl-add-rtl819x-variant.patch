From: DIR-842 R1 port
Subject: [PATCH] irqchip/irq-realtek-rtl: add the RTL819x router variant

The RTL819x (RTL8197F) router SoCs use the same interrupt controller block as
the RTL83xx switch SoCs but differ in two details, both verified against a
working vendor/fork driver on hardware:

 - the IRR registers are numbered the other way round: input 0 lives in the
   first four bits of IRR0 rather than IRR3;
 - the routing field holds the MIPS interrupt-pending number itself (IP4 is
   written as 4), not (parent hwirq - 1).

They also need the CP0 timer interrupt line corrected, which has to happen after
trap_init() re-reads IntCtl and before time_init() requests the line; the init
callback here is the one hook in that window.

--- a/drivers/irqchip/irq-realtek-rtl.c	2026-09-02 13:22:43.659244430 -0300
+++ b/drivers/irqchip/irq-realtek-rtl.c	2026-09-02 13:22:43.667244723 -0300
@@ -11,6 +11,9 @@
 #include <linux/of_address.h>
 #include <linux/irqchip/chained_irq.h>
 
+/* cp0_compare_irq, corrected for the RTL819x timer routing below */
+#include <asm/time.h>
+
 /* Global Interrupt Mask Register */
 #define RTL_ICTL_GIMR		0x00
 /* Global Interrupt Status Register */
@@ -38,12 +41,39 @@
 static void __iomem *realtek_ictl_base[NR_CPUS];
 
 /*
- * IRR0-IRR3 store 4 bits per interrupt, but Realtek uses inverted numbering,
- * placing IRQ 31 in the first four bits. A routing value of '0' means the
- * interrupt is left disconnected. Routing values {1..15} connect to output
- * lines {0..14}.
+ * IRR0-IRR3 store 4 bits per interrupt. A routing value of '0' means the
+ * interrupt is left disconnected.
+ *
+ * The RTL83xx/RTL93xx switch SoCs use inverted register numbering, placing IRQ
+ * 31 in the first four bits of IRR0, and encode the destination as
+ * (parent hwirq - 1), i.e. routing values {1..15} select output lines {0..14}.
+ *
+ * The RTL819x router SoCs number the registers the other way round (IRQ 0 in
+ * the first four bits of IRR0) and encode the destination as the MIPS
+ * interrupt-pending number itself, so IP4 is written as 4.
  */
-#define IRR_OFFSET(idx)		(4 * (3 - (idx * 4) / 32))
+/* MIPS interrupt-pending line the RTL819x SoCs route the CPU timer to */
+#define RTL819X_CP0_TIMER_IP	7
+
+struct realtek_ictl_variant {
+	bool irr_inverted;
+	unsigned int route_bias;
+};
+
+static const struct realtek_ictl_variant realtek_ictl_rtl83xx = {
+	.irr_inverted	= true,
+	.route_bias	= 1,
+};
+
+static const struct realtek_ictl_variant realtek_ictl_rtl819x = {
+	.irr_inverted	= false,
+	.route_bias	= 0,
+};
+
+static const struct realtek_ictl_variant *realtek_ictl_variant = &realtek_ictl_rtl83xx;
+
+#define IRR_OFFSET(idx)		(realtek_ictl_variant->irr_inverted ? \
+				 (4 * (3 - (idx * 4) / 32)) : (4 * ((idx * 4) / 32)))
 #define IRR_SHIFT(idx)		((idx * 4) % 32)
 
 static inline void enable_gimr(unsigned int cpu, unsigned int hw_irq)
@@ -124,7 +154,8 @@
 	guard(raw_spinlock_irqsave)(&irq_lock);
 	output->mask |= BIT(hw_irq);
 	for_each_present_cpu(cpu)
-		write_irr(cpu, hw_irq, output->parent_hwirq - 1);
+		write_irr(cpu, hw_irq,
+			  output->parent_hwirq - realtek_ictl_variant->route_bias);
 
 	return 0;
 }
@@ -265,4 +296,21 @@
 	return realtek_setup_parents(node);
 }
 
+static int __init realtek_rtl819x_of_init(struct device_node *node, struct device_node *parent)
+{
+	realtek_ictl_variant = &realtek_ictl_rtl819x;
+
+	/*
+	 * The bootloader leaves CP0 IntCtl.IPTI pointing at IP2, the line this
+	 * controller is chained to, while the core's timer interrupt is routed
+	 * to IP7. per_cpu_trap_init() re-reads IntCtl after the platform's early
+	 * setup runs, so the correction belongs here: init_IRQ() happens after
+	 * trap_init() and before time_init() asks for the timer line.
+	 */
+	cp0_compare_irq = RTL819X_CP0_TIMER_IP;
+
+	return realtek_rtl_of_init(node, parent);
+}
+
 IRQCHIP_DECLARE(realtek_rtl_intc, "realtek,rtl-intc", realtek_rtl_of_init);
+IRQCHIP_DECLARE(realtek_rtl819x_intc, "realtek,rtl8197f-intc", realtek_rtl819x_of_init);
