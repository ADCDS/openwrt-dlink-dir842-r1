// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include "rtl8197f.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "dlink,dir-842-r1", "realtek,rtl8197f-soc";
	model = "D-Link DIR-842 R1";

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x4000000>;
	};

	/*
	 * Do NOT add a pstore/ramoops carve-out here. An attached ramoops wedges
	 * CPU-originated TX on this board: RX stays healthy while every frame the
	 * box originates is dropped, so it looks alive and is unreachable over
	 * wired LAN. The mechanism is not understood — four correct-looking ways
	 * of doing it were each measured and each still wedged TX — so there is
	 * no "just do it properly" version. See docs/COLD-BOOT-TX-WEDGE.md.
	 */

	chosen {
		bootargs = "console=ttyS0,38400";
		stdout-path = "serial0:38400n8";
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		/* decoded from the stock gpiom.ko dev_buttons table */
		button-reset {
			label = "reset";
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		button-wps {
			label = "wps";
			gpios = <&gpio1 24 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		/*
		 * Stock declares a third button "wifi" at gpio1 4. Left out: if
		 * this unit has no such button the pin may float and emit
		 * spurious KEY_RFKILL, toggling the radio at random.
		 */
	};

	/*
	 * The only software-controllable LED on this board. LAN/WAN/Internet are
	 * driven by the switch's own link/activity indication, and the power LED
	 * has no GPIO at all.
	 *
	 * gpio0 22, not gpio1 25: the latter sits one pin from gpio1 26, the
	 * RTL8367S hardware reset, and writing it held the switch in reset —
	 * which is what "LEDs break the switch" used to mean here.
	 */
	leds {
		compatible = "gpio-leds";

		led-0 {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * External RTL8367S, managed over bit-banged SMI. The chip identifies as
	 * 0x6367/0x0020, which the driver knows as RTL8367RB-VB.
	 *
	 * No reset-gpios: the bootloader has already trained the RGMII trunk and
	 * the driver performs its own register-triggered reset at probe, so
	 * pulsing the reset line as well only adds a way to lose that training.
	 */
	switch {
		compatible = "realtek,rtl8365mb";

		mdc-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		mdio-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;

		/* the SoC MAC inserts and strips the short form of the CPU tag */
		realtek,cpu-tag-4byte;

		/*
		 * The management lines on this board need far longer to settle
		 * than the driver's default. 1500ns is the value the vendor
		 * driver used here; at the default the transactions are
		 * marginal and fail in bursts under load.
		 */
		realtek,clk-delay-ns = <1500>;

		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			ethphy0: ethernet-phy@0 { reg = <0>; };
			ethphy1: ethernet-phy@1 { reg = <1>; };
			ethphy2: ethernet-phy@2 { reg = <2>; };
			ethphy3: ethernet-phy@3 { reg = <3>; };
			ethphy4: ethernet-phy@4 { reg = <4>; };
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* panel order runs the other way: LAN1 is the highest port */
			port@0 { reg = <0>; label = "lan4"; phy-handle = <&ethphy0>; };
			port@1 { reg = <1>; label = "lan3"; phy-handle = <&ethphy1>; };
			port@2 { reg = <2>; label = "lan2"; phy-handle = <&ethphy2>; };
			port@3 { reg = <3>; label = "lan1"; phy-handle = <&ethphy3>; };
			port@4 { reg = <4>; label = "wan";  phy-handle = <&ethphy4>; };

			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&ethernet>;
				phy-mode = "rgmii";
				/* loader-trained values, read back from reg 0x1307 */
				tx-internal-delay-ps = <0>;
				rx-internal-delay-ps = <600>;

				/*
				 * No "pause": 802.3x on this trunk feeds back into the
				 * descriptor pool and stalls the datapath under load.
				 */
				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <41000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x20000>;
				read-only;
			};

			/* per-unit MAC (ASCII at offset 0) and RF calibration */
			partition@20000 {
				label = "MAC";
				reg = <0x20000 0x10000>;
				read-only;
			};

			partition@30000 {
				label = "config";
				reg = <0x30000 0x10000>;
			};

			partition@40000 {
				compatible = "realtek,cvimg";
				label = "firmware";
				reg = <0x40000 0x7b0000>;
			};
		};
	};
};

&ethernet {
	status = "okay";
};

/*
 * Enabled per bring-up milestone as each driver lands:
 *   &pcie0 -> the RTL8822BE 5 GHz radio
 *   &wmac  -> the on-SoC 2.4 GHz radio
 */
