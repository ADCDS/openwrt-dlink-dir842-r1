# Release seed for the OpenWrt-main / 6.18 port.
#
# ★ No 2.4 GHz here. The vendor rtl8192cd source ships in files/ (carried forward
# verbatim from the 4.14 port, same redistribution basis) but is NOT ported to 6.18
# kernel APIs -- see docs/PORT-MAIN-6.18-STATUS.md §6. It will not currently compile.
# Add kmod-rtl8192cd back here once M7 lands.
CONFIG_TARGET_rtl819x=y
CONFIG_TARGET_rtl819x_rtl8197f=y
CONFIG_TARGET_rtl819x_rtl8197f_DEVICE_dlink_dir-842-r1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_KERNEL_PRINTK_TIME=y
# ---- 5 GHz: RTL8822BE on PCIe via rtw88 (backports) + hostapd ----
CONFIG_PACKAGE_kmod-rtw88-8822be=y
CONFIG_PACKAGE_rtl8822be-firmware=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iw=y
# ---- WAN ----
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
# ---- bench / diagnostics ----
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_conntrack=y
# ---- web UI ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-upnp=y
