# Release seed for the OpenWrt-main / 6.18 port: both radios, HW NAT offload, LuCI.
CONFIG_TARGET_rtl819x=y
CONFIG_TARGET_rtl819x_rtl8197f=y
CONFIG_TARGET_rtl819x_rtl8197f_DEVICE_dlink_dir-842-r1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_KERNEL_PRINTK_TIME=y
# ---- 5 GHz: RTL8822BE on PCIe via rtw88 (backports) + hostapd ----
CONFIG_PACKAGE_kmod-rtw88-8822be=y
CONFIG_PACKAGE_rtl8822be-firmware=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iw=y
# ---- 2.4 GHz: on-SoC WMAC via the vendor rtl8192cd driver (WEXT) ----
CONFIG_PACKAGE_kmod-rtl8192cd=y
CONFIG_PACKAGE_wireless-tools=y
# ---- WAN ----
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
# ---- bench / diagnostics ----
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_conntrack=y
# ---- web UI ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-upnp=y
