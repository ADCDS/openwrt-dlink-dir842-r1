# Minimal bring-up seed for the OpenWrt-main / 6.18 port (milestones M0-M3).
# No wireless, no LuCI: just the target, both image types, and bench tools.
CONFIG_TARGET_rtl819x=y
CONFIG_TARGET_rtl819x_rtl8197f=y
CONFIG_TARGET_rtl819x_rtl8197f_DEVICE_dlink_dir-842-r1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_DEVEL=y
CONFIG_KERNEL_PRINTK_TIME=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ethtool=y
# No 2.4 GHz vendor driver before M7
# CONFIG_PACKAGE_kmod-rtl8192cd is not set
