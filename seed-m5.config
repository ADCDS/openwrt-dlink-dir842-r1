CONFIG_TARGET_realtek=y
CONFIG_TARGET_realtek_rtl8197f=y
CONFIG_TARGET_realtek_rtl8197f_DEVICE_GWR1200AC-V1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# ---- M5 WiFi: rtw88 (RTL8822BE 5GHz on PCIe) + hostapd AP ----
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-rtw88=y
CONFIG_PACKAGE_rtl8822be-firmware=y
CONFIG_PACKAGE_wpad-basic=y
# CONFIG_PACKAGE_wpad-mini is not set
CONFIG_PACKAGE_iw=y
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11N_SUPPORT=y
CONFIG_DRIVER_11W_SUPPORT=y
# ---- M7.2 PPPoE WAN ----
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
# ---- M7.3 line-rate bench + diagnostics ----
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
# ---- R3: LED provider (trigger infra was already on, provider was missing) ----
CONFIG_PACKAGE_kmod-leds-gpio=y
# ---- R5: web UI — UNBLOCKED and landed. Requires the feed pins in feeds.conf. ----
# Stock's headline feature is its web admin, so LuCI was the biggest single parity gap.
# It was blocked because the luci feed tracks master, whose luci-base has been
# ucode-based since 2023: the build died compiling ucode-mod-html / liblucihttp-ucode
# against this 19.07-era base. Same class as the tree's "default feeds resolve to
# incompatible CURRENT versions" trap.
# ★ THE FIX IS IN feeds.conf (not here) — BOTH feeds pinned to the 19.07 branch:
#   src-git luci     https://git.openwrt.org/project/luci.git;openwrt-19.07
#   src-git packages https://git.openwrt.org/feed/packages.git;openwrt-19.07
# Pinning `packages` too is REQUIRED, not cosmetic: master split miniupnpd into
# miniupnpd-iptables/-nftables so a plain `miniupnpd` dep does not resolve, and cgi-io
# is absent there as well. Then:
#   ./scripts/feeds update luci packages
#   ./scripts/feeds install luci-base luci-mod-admin-full luci-theme-bootstrap \
#                           luci-app-firewall luci-app-upnp luci-app-opkg cgi-io miniupnpd
# 19.07's LuCI is Lua-era: no ucode anywhere, and its runtime deps (rpcd, uhttpd,
# libubus-lua) come from base package/ rather than the feed.
# Measured cost: 4.00 -> 4.75 MB of the 7.9 MB firmware partition (2.96 MB free).
CONFIG_PACKAGE_luci=y
# ★ Selected BY NAME, not left to the luci meta-package's dependency resolution:
# if `luci` is missing from the feeds-install list its symbol vanishes and every
# one of these goes with it, silently, producing an image with no web server.
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_qos-scripts=y
CONFIG_PACKAGE_cgi-io=y
# ---- R5: IPv6 now that ipv6.disable=1 is off the kernel cmdline ----
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
# ---- R1: crashlog OFF ----
# OpenWrt's crashlog handler faults on this SoC: crashlog_printf() dies on a bogus
# 0x00000c00 access from inside die(), so instead of recording the FIRST oops it recurses
# ("Oops[#448]", PID 0, task.stack=NULL), floods the console and hangs the boot — masking
# the real flash-boot crash (#11). ★ THIS knob is the one that works: CONFIG_KERNEL_*
# entries are injected AFTER the target/linux/*/config-4.14 merge, so the
# "# CONFIG_CRASHLOG is not set" in the subtarget config is silently overridden by it.
# Verified: System.map crashlog symbol count 10 -> 0.
# CONFIG_KERNEL_CRASHLOG is not set
