+/* ── OpenWrt port: pull in the SoC BSP header ────────────────────────────────
+ * MEASURED (gcc -E -dD on the real kbuild command line for 8192cd_osdep.o):
+ * the preprocessed TU contains ZERO bspchip.h line markers and ZERO BSP_*
+ * defines.  Every `#include <bspchip.h>` in this driver is dead code here,
+ * because each one hangs off a platform-identification macro that the Realtek
+ * SDK supplies from the *kernel's* .config and that this tree does not have:
+ *
+ *   8192cd_osdep.c:168  #if defined(CONFIG_RTL_819X) && defined(__LINUX_2_6__)
+ *   8192cd_hw.c:65      #if defined(USE_RTL8186_SDK) && !defined(__OSK__)
+ *
+ * CONFIG_RTL_819X is self-defined only at 8192cd_cfg.h:168, which sits under
+ * `#if !defined(__LINUX_2_6__)` AND `#if defined(CONFIG_RTL8196B|C|8198)` --
+ * both false on a 4.14 kernel / 8197F SoC, so it is never defined.
+ * USE_RTL8186_SDK is likewise never defined (absent from the preprocessed TU).
+ * That -- not the -I search path -- is why every BSP_* symbol was undeclared:
+ * the #include lines are never reached, so no -I could ever have helped.
+ *
+ * Note also that -DUSE_RLX_BSP on the command line is inert: line 2007 below
+ * does `#undef USE_RLX_BSP` under `#ifdef NOT_RTK_BSP`, and NOT_RTK_BSP is set
+ * by this port.  (Proof: the preprocessed TU literally contains that #undef.)
+ *
+ * Including it from here rather than with -include is deliberate: 8192cd_cfg.h
+ * is reached by every TU *after* the kernel's own headers, so it cannot get
+ * ahead of asm/uaccess.h / linux/thread_info.h the way -include did.
+ * bspchip.h is self-contained (it includes only <linux/version.h>) and all of
+ * its generic-looking macros (REG32/REG16/REG08/REG8) are #ifndef-guarded.
+ */
+#if defined(CONFIG_RTL_8197F) && defined(__KERNEL__)
+#include <bspchip.h>
+#endif
+
 #endif // _8192CD_CFG_H_
 
